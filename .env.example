# Copy to .env and adjust. Never commit .env.

# Required: signing key for session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MV_SECRET_KEY=

# Local PostgreSQL (Docker Compose only).
POSTGRES_USER=meritvector
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=meritvector

# Demo sign-in as synthetic users. Must be false in any real deployment (use SSO).
MV_DEMO_AUTH=true
MV_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional LLM provider. Only "deterministic" exists in v0.1 (no external AI calls).
MV_LLM_PROVIDER=deterministic

# Local development without Docker (defaults shown):
# DATABASE_URL=sqlite:///./artifacts/meritvector.db
# MV_DATA_DIR=./data/synthetic
# MV_ARTIFACT_DIR=./artifacts/models
# MV_BOOTSTRAP_N=200
